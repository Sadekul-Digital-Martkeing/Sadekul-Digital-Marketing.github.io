<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sadekul Digital Marketing</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f7fb;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #111827;
      color: white;
      padding: 25px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    header h1 {
      font-size: 25px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
    }

    .hero {
      text-align: center;
      padding: 90px 20px;
      background: white;
    }

    .hero h2 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      color: #555;
      max-width: 650px;
      margin: auto;
    }

    .button {
      display: inline-block;
      margin-top: 25px;
      padding: 13px 25px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 7px;
    }

    .services {
      padding: 60px 8%;
      text-align: center;
    }

    .services h2 {
      margin-bottom: 30px;
    }

    .cards {
      display: flex;
      gap: 20px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .card {
      background: white;
      padding: 30px;
      width: 280px;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .card h3 {
      margin-bottom: 10px;
    }

    footer {
      background: #111827;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 30px;
    }
  </style>
</head>

<body>

  <header>
    <h1>Sadekul Digital Marketing</h1>

    <nav>
      <a href="#home">Home</a>
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero" id="home">
    <h2>Grow Your Business Online</h2>
    <p>
      Professional digital marketing solutions to help businesses
      reach more customers and grow online.
    </p>

    <a class="button" href="#contact">Get Started</a>
  </section>

  <section class="services" id="services">
    <h2>Our Services</h2>

    <div class="cards">

      <div class="card">
        <h3>Meta Ads</h3>
        <p>Reach the right audience with effective Facebook and Instagram advertising.</p>
      </div>

      <div class="card">
        <h3>Digital Marketing</h3>
        <p>Build your online presence and connect with potential customers.</p>
      </div>

      <div class="card">
        <h3>Audience Targeting</h3>
        <p>Find and target the right customers for your business.</p>
      </div>

    </div>
  </section>

  <section class="services" id="contact">
    <h2>Contact Us</h2>
    <p>Ready to grow your business online?</p>
    <a class="button" href="mailto:contact@example.com">Contact Now</a>
  </section>

  <footer>
    <p>© 2026 Sadekul Digital Marketing. All rights reserved.</p>
  </footer>

</body>
</html>
